generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ServeStyle {
  BLACK
  WITH_MILK
}

model CoffeeEntry {
  id             String      @id @default(cuid())
  date           DateTime
  company        String
  name           String
  region         String?
  country        String
  location       String?
  altitude       String?
  process        String
  varietal       String?
  cupProfileRaw  String?
  grindSetting   Float?
  brewMethod     String?
  serve          ServeStyle?
  rating         Float
  notes          String?
  nicholasNotes  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  coffeeTags     CoffeeTag[]
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  coffeeTags CoffeeTag[]
}

model CoffeeTag {
  id       String      @id @default(cuid())
  coffee   CoffeeEntry @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  coffeeId String
  tag      Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@unique([coffeeId, tagId])
}
